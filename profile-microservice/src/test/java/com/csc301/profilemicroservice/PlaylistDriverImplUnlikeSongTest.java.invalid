package com.csc301.profilemicroservice;import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.StatementResult;
import org.neo4j.driver.v1.Transaction;
import java.util.HashMap;
import java.util.Map;
import static org.mockito.Mockito.*;
import org.springframework.stereotype.Repository;

@RunWith(MockitoJUnitRunner.class)
public class PlaylistDriverImplUnlikeSongTest {
    @Mock
    Session mockSession;
    @Mock
    Transaction mockTransaction;
    @Mock
    StatementResult mockStatementResult;
    @Mock
    Driver mockDriver;
    // Assuming that PlaylistDriverImpl uses driver from ProfileMicroserviceApplication
    PlaylistDriverImpl playlistDriver = new PlaylistDriverImpl();
    @Test
    @Category(Categories.valid.class)
    public void unlikeSongWithValidInputs() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        
        Map<String, Object> params = new HashMap<>();
        params.put("plName", "validUserName-favourites");
        params.put("songId", "validSongId");
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true).thenReturn(true).thenReturn(true);
        DbQueryStatus result = playlistDriver.unlikeSong("validUserName", "validSongId");
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_OK);
    }
    
    @Test
    @Category(Categories.invalid.class)
    public void unlikeSongWithNullUserName() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        DbQueryStatus result = playlistDriver.unlikeSong(null, "validSongId");
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_ERROR_GENERIC);
    }
    @Test
    @Category(Categories.invalid.class)
    public void unlikeSongWithNullSongId() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        DbQueryStatus result = playlistDriver.unlikeSong("validUserName", null);
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_ERROR_GENERIC);
    }
    @Test
    @Category(Categories.invalid.class)
    public void unlikeSongWithBothNullInputs() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        DbQueryStatus result = playlistDriver.unlikeSong(null, null);
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_ERROR_GENERIC);
    }
    @Test
    @Category(Categories.invalid.class)
    public void unlikeSongWithNonExistentSong() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        
        Map<String, Object> params = new HashMap<>();
        params.put("plName", "validUserName-favourites");
        params.put("songId", "nonExistentSongId");
        
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true).thenReturn(false);
       
        DbQueryStatus result = playlistDriver.unlikeSong("validUserName", "nonExistentSongId");
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_ERROR_GENERIC);
    }
    @Test
    @Category(Categories.invalid.class)
    public void unlikeSongNotInUserPlaylist() {
        when(ProfileMicroserviceApplication.driver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        
        Map<String, Object> params = new HashMap<>();
        params.put("plName", "validUserName-favourites");
        params.put("songId", "validButNotInPlaylistSongId");
        
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true).thenReturn(true).thenReturn(false);
        DbQueryStatus result = playlistDriver.unlikeSong("validUserName", "validButNotInPlaylistSongId");
        assertEquals(result.getdbQueryExecResult(), DbQueryExecResult.QUERY_ERROR_GENERIC);
    }
}