package com.csc301.profilemicroservice;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.Transaction;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.neo4j.driver.v1.StatementResult;
import org.springframework.stereotype.Repository;

public class PlaylistDriverImplDeleteSongFromDbTest {
    @Mock
    private Driver driver;
    @Mock
    private Session session;
    @Mock
    private Transaction transaction;
    @Test
    @Tag("valid")
    public void testDeleteSongFromDbSuccess() {
        PlaylistDriverImpl driverImpl = new PlaylistDriverImpl();
        String songId = "abc";
        Mockito.when(driver.session()).thenReturn(session);
        Mockito.when(session.beginTransaction()).thenReturn(transaction);
        DbQueryStatus response = driverImpl.deleteSongFromDb(songId);
        Assertions.assertEquals(DbQueryExecResult.QUERY_OK, response.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void testDeleteNonExistingSong() {
        PlaylistDriverImpl driverImpl = new PlaylistDriverImpl();
        String songId = "xyz";
        
        Mockito.when(driver.session()).thenReturn(session);
        Mockito.when(session.beginTransaction()).thenReturn(transaction);
        DbQueryStatus response = driverImpl.deleteSongFromDb(songId);
        Assertions.assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void testDeleteSongWithNullId() {
        PlaylistDriverImpl driverImpl = new PlaylistDriverImpl();
        Mockito.when(driver.session()).thenReturn(session);
        Mockito.when(session.beginTransaction()).thenReturn(transaction);
        DbQueryStatus response = driverImpl.deleteSongFromDb(null);
        Assertions.assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.getdbQueryExecResult());
    }
    @Test
    @Tag("integration")
    public void testDeleteSongDbConnectionFailure() {
        PlaylistDriverImpl driverImpl = new PlaylistDriverImpl();
        String songId = "abc";
        Mockito.when(driver.session()).thenThrow(new RuntimeException());
        DbQueryStatus response = driverImpl.deleteSongFromDb(songId);
        Assertions.assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.getdbQueryExecResult());
    }
}