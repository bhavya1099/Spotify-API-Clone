package com.csc301.profilemicroservice;import static org.junit.Assert.*;
import static org.mockito.Mockito.*;
import java.util.Map;
import java.util.HashMap;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.Transaction;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.StatementResult;
import org.springframework.stereotype.Repository;

public class PlaylistDriverImplDeleteSongFromDbTest {
    @Mock
    Session mockSession;
    
    @Mock
    Transaction mockTransaction;
    
    @InjectMocks
    PlaylistDriverImpl driver;
    
    @Before
    public void setup() {
        MockitoAnnotations.initMocks(this);
    }
    
    @Category(Categories.valid.class)
    @Test
    public void testDeleteSongFromDbSuccessfully() {
        String songId = "123";
        doReturn(mockTransaction).when(mockSession).beginTransaction();
        doNothing().when(mockTransaction).run(anyString(), any(Map.class));
        DbQueryStatus status = driver.deleteSongFromDb(songId);
        
        assertEquals("DELETE", status.getDbQueryCode());
        assertEquals(DbQueryExecResult.QUERY_OK, status.getMessage());
    }
    
    @Category(Categories.invalid.class)
    @Test
    public void testDeleteSongFromDbWithNullSongId() {
        DbQueryStatus status = driver.deleteSongFromDb(null);
        
        assertEquals("DELETE", status.getDbQueryCode());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getMessage());
    }
    
    @Category(Categories.invalid.class)
    @Test
    public void testDeleteSongFromDbWithInvalidSongId() {
        String songId = "456";
        doReturn(mockTransaction).when(mockSession).beginTransaction();
        doThrow(new RuntimeException()).when(mockTransaction).run(anyString(), any(Map.class));
        DbQueryStatus status = driver.deleteSongFromDb(songId);
        
        assertEquals("DELETE", status.getDbQueryCode());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getMessage());
    }
}