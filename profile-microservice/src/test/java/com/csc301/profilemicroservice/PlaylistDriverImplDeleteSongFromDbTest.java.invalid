package com.csc301.profilemicroservice;import org.junit.BeforeClass;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.*;
import static org.mockito.Mockito.*;
import org.neo4j.driver.v1.*;
import java.util.HashMap;
import java.util.Map;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.StatementResult;
import org.neo4j.driver.v1.Transaction;
import org.springframework.stereotype.Repository;

public class PlaylistDriverImplDeleteSongFromDbTest {
    static PlaylistDriverImpl playlistDriverImpl;
    @BeforeClass
    public static void setup() {
        playlistDriverImpl = new PlaylistDriverImpl();
        playlistDriverImpl.driver = mock(Driver.class);
    }
    @Test
    @Category(Categories.valid.class)
    public void testDeleteSongFromDbWithValidSongId() {
        String songId = "123";
        Session session = mock(Session.class);
        when(playlistDriverImpl.driver.session()).thenReturn(session);
        when(session.writeTransaction(any())).thenReturn(null);
        DbQueryStatus result = playlistDriverImpl.deleteSongFromDb(songId);
        assertEquals("DELETE", result.getdbQueryMessage()); // Error Correction
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecutionResult());// Error Correction
    }
    @Test(expected = NullPointerException.class)
    @Category(Categories.invalid.class)
    public void testDeleteSongFromDbWithNullSongId() {
        playlistDriverImpl.deleteSongFromDb(null);
    }
    @Test
    @Category(Categories.boundary.class)
    public void testDeleteSongFromDbWithNonExistingSongId() {
        String songId = "999";
        Session session = mock(Session.class);
        Transaction transaction = mock(Transaction.class);
        StatementResult result = mock(StatementResult.class);
        when(session.writeTransaction(any())).thenThrow(new Exception());
        when(playlistDriverImpl.driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(transaction);
        when(transaction.run(anyString(), anyMap())).thenReturn(result); // Error Correction
        when(result.hasNext()).thenReturn(false); 
        
        DbQueryStatus dbQueryStatus = playlistDriverImpl.deleteSongFromDb(songId);
        assertEquals("DELETE", dbQueryStatus.getdbQueryMessage()); // Error Correction
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, dbQueryStatus.getdbQueryExecutionResult());// Error Correction
    }
}