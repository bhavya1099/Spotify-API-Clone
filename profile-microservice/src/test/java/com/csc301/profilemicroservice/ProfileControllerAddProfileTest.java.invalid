public class ProfileControllerAddProfileTest {
    @Mock
    private PlaylistDriverImpl playlistDriver;
    @Mock
    private Utils utils;
    @InjectMocks
    private ProfileController profileController;
    @Mock
    private HttpServletRequest mockedRequest;
    @BeforeEach
    public void setup() {
        MockitoAnnotations.openMocks(this);
        profileController = new ProfileController(null, playlistDriver); // Passing null for unused ProfileDriverImpl
    }
    @Test
    @Tag("valid")
    public void validSongAddition() {
        // Arrange
        String validSongId = "123";
        String validSongName = "TestSong";
        String mockUrl = "http://mock-url";
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Song added successfully", DbQueryExecResult.QUERY_OK);
        when(Utils.getUrl(mockedRequest)).thenReturn(mockUrl);
        when(playlistDriver.addSong(validSongId, validSongName)).thenReturn(mockDbQueryStatus);
        // Act
        Map<String, Object> actualResponse = profileController.addProfile(validSongId, validSongName, mockedRequest);
        // Assert
        assertEquals(String.format("POST %s", mockUrl), actualResponse.get("path"));
        assertEquals(mockDbQueryStatus.getMessage(), actualResponse.get("message"));
        assertEquals(mockDbQueryStatus.getdbQueryExecResult().toString(), ((Map<String, Object>) actualResponse).get("status").toString());
    }
