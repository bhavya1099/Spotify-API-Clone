    }
    @Test
    @Tag("valid")
    public void addSongSuccessfully() {
        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setRequestURI("/addSong/12345/SongTitle");
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        Mockito.when(playlistDriver.addSong("12345", "SongTitle")).thenReturn(mockDbQueryStatus);
        Map<String, Object> response = profileController.addProfile("12345", "SongTitle", request);
        assertEquals(mockDbQueryStatus.getMessage(), response.get("message"), "The message should match the success response.");
        assertEquals("POST /addSong/12345/SongTitle", response.get("path"), "The path should be formatted correctly.");
        assertEquals(DbQueryExecResult.QUERY_OK, ((DbQueryExecResult) response.get("status")), "The status should indicate a successful addition.");
    }
    @Test
    @Tag("invalid")
    public void addSongWithInvalidParameters() {
        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setRequestURI("/addSong//");
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Invalid input", DbQueryExecResult.QUERY_ERROR_GENERIC);
        Mockito.when(playlistDriver.addSong("", null)).thenReturn(mockDbQueryStatus);
        Map<String, Object> response = profileController.addProfile("", null, request);
        assertEquals(mockDbQueryStatus.getMessage(), response.get("message"), "The message should match the invalid input response.");
        assertEquals("POST /addSong//", response.get("path"), "The path should be formatted correctly.");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, ((DbQueryExecResult) response.get("status")), "The status should indicate an error.");
    }
    @Test
    @Tag("boundary")
    public void addSongWithBoundaryCondition() {
        String veryLongSongName = "SongTitle".repeat(100); // TODO: Adjust the max length as required.
        MockHttpServletRequest request = new MockHttpServletRequest();
        request.setRequestURI("/addSong/12345/" + veryLongSongName);
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        Mockito.when(playlistDriver.addSong("12345", veryLongSongName)).thenReturn(mockDbQueryStatus);
        Map<String, Object> response = profileController.addProfile("12345", veryLongSongName, request);
        assertEquals(mockDbQueryStatus.getMessage(), response.get("message"), "The message should match the success response for long song name.");
        assertEquals("POST /addSong/12345/" + veryLongSongName, response.get("path"), "The path should be formatted correctly for boundary case.");
