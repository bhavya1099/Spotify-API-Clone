public class ProfileControllerAddProfileTest {
    @InjectMocks
    ProfileController profileController;
    
    @Mock
    HttpServletRequest httpServletRequest;
    
    @Mock
    ProfileDriverImpl profileDriver;
    @Mock
    DbQueryStatus dbQueryStatus;
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Tag("valid")
    void testValidParameters() {
        Map<String, String> requestMAP = new HashMap<>();
        requestMAP.put("KEY_USER_NAME", "Smith");
        requestMAP.put("KEY_USER_FULLNAME", "John");
        requestMAP.put("KEY_USER_PASSWORD", "123456");
        when(httpServletRequest.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/"));
        when(profileDriver.createUserProfile(requestMAP.get("KEY_USER_NAME"), requestMAP.get("KEY_USER_FULLNAME"), requestMAP.get("KEY_USER_PASSWORD"))).thenReturn(dbQueryStatus);
        when(dbQueryStatus.getdbQueryExecResult()).thenReturn(DbQueryExecResult.QUERY_OK);
        Map<String, Object> response = profileController.addProfile(requestMAP, httpServletRequest);
        assertNotNull(response.get("message"));
        assertEquals("post http://localhost:8080/", response.get("path"));
    }
    
    @Test
    @Tag("invalid")
    void testInvalidParameters() {
        Map<String, String> requestMAP = new HashMap<>();
        requestMAP.put("KEY_USER_NAME", "");
        requestMAP.put("KEY_USER_FULLNAME", "John");
        requestMAP.put("KEY_USER_PASSWORD", "");
        when(profileDriver.createUserProfile(requestMAP.get("KEY_USER_NAME"), requestMAP.get("KEY_USER_FULLNAME"), requestMAP.get("KEY_USER_PASSWORD"))).thenReturn(dbQueryStatus);
        when(dbQueryStatus.getdbQueryExecResult()).thenReturn(DbQueryExecResult.QUERY_ERROR_GENERIC);
        Map<String, Object> response = profileController.addProfile(requestMAP, httpServletRequest);
        assertNotNull(response.get("message"));
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.get("status"));
    }
    
    @Test
    @Tag("invalid")
    void testNoParameters() {
        Exception exception = assertThrows(NullPointerException.class, () -> {
            Map<String, Object> response = profileController.addProfile(null, httpServletRequest);
        });
        String expectedMessage = "Cannot invoke \"Object.equals(Object)\" because the return value of \"java.util.Map.get(Object)\" is null";
        String actualMessage = exception.getMessage();
        assertEquals(expectedMessage, actualMessage);
    }
    
    @Test
    @Tag("invalid")
    void testNullHttpServletRequest() {
        Map<String, String> requestMAP = new HashMap<>();
        requestMAP.put("KEY_USER_NAME", "Smith");
        requestMAP.put("KEY_USER_FULLNAME", "John");
