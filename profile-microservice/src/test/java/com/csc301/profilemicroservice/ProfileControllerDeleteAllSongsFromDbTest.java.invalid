    public void deleteAllSongsWithValidSongId() {
        DbQueryStatus successStatus = new DbQueryStatus("Deleted successfully", DbQueryExecResult.QUERY_OK);
        when(playlistDriver.deleteSongFromDb(validSongId)).thenReturn(successStatus);
        Map<String, Object> response = profileController.deleteAllSongsFromDb(validSongId, request);
        assertEquals("Deleted successfully", response.get("message"));
        assertEquals("PUT http://localhost:8080/somePath", response.get("path"));
        assertEquals(DbQueryExecResult.QUERY_OK, ((Map<String, Object>) response).get("status"));
    }
