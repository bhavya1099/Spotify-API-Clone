        // Arrange
        String userName = "user1"; // TODO: Replace with valid username
        String friendUserName = "friend1"; // TODO: Replace with valid friend username
        String mockUrl = "http://localhost:8080/followFriend";
        DbQueryStatus successStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        DbQueryStatus genericErrorStatus = new DbQueryStatus("Generic error", DbQueryExecResult.QUERY_ERROR_GENERIC);
        DbQueryStatus notFoundStatus = new DbQueryStatus("Not found", DbQueryExecResult.QUERY_ERROR_NOT_FOUND);
        when(request.getRequestURL()).thenReturn(new StringBuffer(mockUrl));
        // Act & Assert
        when(profileDriver.followFriend(userName, friendUserName)).thenReturn(successStatus);
        Map<String, Object> successResponse = profileController.followFriend(userName, friendUserName, request);
        assertEquals("PUT " + mockUrl, successResponse.get("path"));
        assertEquals("Success", successResponse.get("message"));
        assertEquals("OK", successResponse.get("status"));
        when(profileDriver.followFriend(userName, friendUserName)).thenReturn(genericErrorStatus);
        Map<String, Object> errorResponse = profileController.followFriend(userName, friendUserName, request);
        assertEquals("PUT " + mockUrl, errorResponse.get("path"));
        assertEquals("Generic error", errorResponse.get("message"));
        assertEquals("ERROR", errorResponse.get("status"));
        when(profileDriver.followFriend(userName, friendUserName)).thenReturn(notFoundStatus);
        Map<String, Object> notFoundResponse = profileController.followFriend(userName, friendUserName, request);
        assertEquals("PUT " + mockUrl, notFoundResponse.get("path"));
        assertEquals("Not found", notFoundResponse.get("message"));
        assertEquals("NOT_FOUND", notFoundResponse.get("status"));
