        when(profileDriver.followFriend(userName, friendUserName)).thenReturn(new DbQueryStatus("Friend followed successfully", DbQueryExecResult.QUERY_OK));
        Map<String, Object> response = profileController.followFriend(userName, friendUserName, request);
        assertEquals("Friend followed successfully", response.get("message"));
        assertEquals(DbQueryExecResult.QUERY_OK, response.get("status"));
    }
