package com.csc301.profilemicroservice;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import javax.servlet.http.HttpServletRequest;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;
import org.springframework.http.HttpStatus;
import okhttp3.RequestBody;
import java.util.Map;

public class UtilsGetUrlTest {
    @Test
    @Tag("valid")
    public void urlWithQueryStringPresent() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/path"));
        Mockito.when(mockRequest.getQueryString()).thenReturn("key=value");
        // Act
        String actualUrl = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/path?key=value", actualUrl);
    }
    @Test
    @Tag("valid")
    public void urlWithoutQueryString() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/path"));
        Mockito.when(mockRequest.getQueryString()).thenReturn(null);
        // Act
        String actualUrl = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/path", actualUrl);
    }
    @Test
    @Tag("invalid")
    public void urlWithEmptyQueryString() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/path"));
        Mockito.when(mockRequest.getQueryString()).thenReturn("");
        // Act
        String actualUrl = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/path?", actualUrl);
    }
    @Test
    @Tag("boundary")
    public void urlWithLongQueryString() {
        // TODO: Adjust query string value for testing edge cases with long data appropriately.
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/path"));
        String longQueryString = "key1=value1&key2=value2&key3=value3&key4=value4";
        Mockito.when(mockRequest.getQueryString()).thenReturn(longQueryString);
        // Act
        String actualUrl = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/path?" + longQueryString, actualUrl);
    }
    @Test
    @Tag("integration")
    public void urlConstructionIntegrationTest() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/api/resource"));
        Mockito.when(mockRequest.getQueryString()).thenReturn("param1=value1&param2=value2");
