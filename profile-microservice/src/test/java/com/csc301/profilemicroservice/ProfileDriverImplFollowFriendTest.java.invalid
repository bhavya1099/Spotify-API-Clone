package com.csc301.profilemicroservice;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.Tag;
import org.neo4j.driver.v1.*;
import org.junit.jupiter.api.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Record;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.StatementResult;
import org.neo4j.driver.v1.Transaction;
import org.springframework.stereotype.Repository;

class ProfileDriverImplFollowFriendTest {
    // Mock dependencies
    Driver mockDriver = mock(Driver.class);
    Session mockSession = mock(Session.class);
    Transaction mockTransaction = mock(Transaction.class);
    StatementResult mockStatementResult = mock(StatementResult.class);
    Record mockRecord = mock(Record.class);
    ProfileDriverImpl profileDriver = new ProfileDriverImpl(mockDriver);
    @Test
    @Tag("invalid")
    public void followFriendWithNullUserName() {
        DbQueryStatus status = profileDriver.followFriend(null, "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void followFriendWithNullFrndUserName() {
        DbQueryStatus status = profileDriver.followFriend("validUserName", null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void followFriendWithEqualUserNameAndFrndUserName() {
        DbQueryStatus status = profileDriver.followFriend("sameUserName", "sameUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void followFriendWithNonExistentUserName() {
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), anyMap())).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(false); // User does not exist
        DbQueryStatus status = profileDriver.followFriend("nonExistentUserName", "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void followFriendWithNonExistentFrndUserName() {
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run("MATCH (n:profile {userName: $userName}) RETURN n.userName as u", anyMap())).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true); // User exists
        when(mockTransaction.run("MATCH (n:profile {userName: $frndUserName}) RETURN n.userName as f", anyMap())).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(false); // Friend does not exist
        DbQueryStatus status = profileDriver.followFriend("validUserName", "nonExistentFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void followFriendWithExistingFollowRelationship() {
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), anyMap())).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true); // Relationship already exists
        when(mockStatementResult.next()).thenReturn(mockRecord);
        when(mockRecord.get("bool").asBoolean()).thenReturn(true); // Already following
        DbQueryStatus status = profileDriver.followFriend("validUserName", "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("valid")
    public void followFriendWithValidFollowOperation() {
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), anyMap())).thenReturn(mockStatementResult);
        when(mockStatementResult.hasNext()).thenReturn(true); // User and Friend exist
        when(mockStatementResult.next()).thenReturn(mockRecord);
        when(mockRecord.get("bool").asBoolean()).thenReturn(false); // Not already following
        DbQueryStatus status = profileDriver.followFriend("validUserName", "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_OK, (DbQueryExecResult) status.getdbQueryExecResult());
    }
    @Test
    @Tag("integration")
    public void followFriendWithDatabaseException() {
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenThrow(new RuntimeException("Database exception"));
        DbQueryStatus status = profileDriver.followFriend("validUserName", "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) status.getdbQueryExecResult());
    }
}