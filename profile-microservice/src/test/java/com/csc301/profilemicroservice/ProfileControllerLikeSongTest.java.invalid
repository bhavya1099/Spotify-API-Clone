    @Test
    @Tag("valid")
    public void validInputSongLike() throws Exception {
        String userName = "testUser";
        String songId = "testSong";
        DbQueryStatus dbQueryStatus = new DbQueryStatus("Operation Successful", DbQueryExecResult.QUERY_OK);
        // Mocking
        when(playlistDriver.likeSong(userName, songId)).thenReturn(dbQueryStatus);
        Response mockedResponse = mock(Response.class);
        when(client.newCall(any(Request.class)).execute()).thenReturn(mockedResponse);
        when(mockedResponse.body().string()).thenReturn("{\"status\": \"OK\"}");
        when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost/likeSong/" + userName + "/" + songId));
        // Act
        Map<String, Object> response = profileController.likeSong(userName, songId, request);
        // Assert
        assertNotNull(response);
        assertEquals(DbQueryExecResult.QUERY_OK, dbQueryStatus.getdbQueryExecResult());
        assertEquals("Operation Successful", dbQueryStatus.getMessage());
        assertEquals("PUT http://localhost/likeSong/testUser/testSong", response.get("path"));
    }
