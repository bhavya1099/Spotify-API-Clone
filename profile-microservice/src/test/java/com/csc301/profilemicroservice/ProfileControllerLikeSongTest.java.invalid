    @Test
    @Category(Categories.valid.class)
    public void testMethodConcurrentLikes() throws Exception {
        String userName1 = "testUser1";
        String userName2 = "testUser2";
        String songId = "testSongId";
        String url = "http";
        String path = "PUT " + url;
        DbQueryStatus dbQueryStatus = new DbQueryStatus("Song liked successfully", DbQueryExecResult.QUERY_OK);
        Response response = new Response.Builder()
                .code(200)
                .message("OK")
                .body(okhttp3.ResponseBody.create("{\"status\":\"OK\"}", null))
                .build();
        when(request.getRequestURL()).thenReturn(new StringBuffer(url));
        when(playlistDriver.likeSong(anyString(), eq(songId))).thenReturn(dbQueryStatus);
        when(client.newCall(new Request.Builder().url(url).put(new FormBody.Builder().build()).build())).thenReturn(response);
        Map<String, Object> result1 = profileController.likeSong(userName1, songId, request);
        Map<String, Object> result2 = profileController.likeSong(userName2, songId, request);
        assertEquals((String) path, (String) result1.get("path"));
        assertEquals((String) "Song liked successfully", (String) result1.get("message"));
        assertEquals(DbQueryExecResult.QUERY_OK, (DbQueryExecResult) Utils.getResponseStatus(result1));
        assertEquals((String) path, (String) result2.get("path"));
        assertEquals((String) "Song liked successfully", (String) result2.get("message"));
        assertEquals(DbQueryExecResult.QUERY_OK, (DbQueryExecResult) Utils.getResponseStatus(result2));
    }
