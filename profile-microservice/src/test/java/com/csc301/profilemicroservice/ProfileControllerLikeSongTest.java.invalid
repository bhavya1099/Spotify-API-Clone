        Mockito.when(request.getRequestURI()).thenReturn("/test");
        Map<String, Object> response = profileController.likeSong("validUserName", "validSongId", request);
        assertEquals(
            DbQueryExecResult.QUERY_ERROR_GENERIC.name(),
