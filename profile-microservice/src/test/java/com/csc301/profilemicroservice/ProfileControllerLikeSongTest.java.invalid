        when(playlistDriver.likeSong(userName, songId)).thenReturn(mockDbQueryStatus);
        when(client.newCall(any(Request.class)).execute()).thenReturn(mockResponse);
        Map<String, Object> response = profileController.likeSong(userName, songId, request);
        assertEquals("PUT " + Utils.getUrl(request), (String) response.get("path"));
        assertEquals("Query OK", (String) response.get("message"));
        assertEquals(DbQueryExecResult.QUERY_OK, mockDbQueryStatus.getdbQueryExecResult());
    }
