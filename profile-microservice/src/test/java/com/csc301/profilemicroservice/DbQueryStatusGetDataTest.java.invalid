```javapackage com.csc301.profilemicroservice;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.*;

public class DbQueryStatusGetDataTest {
    @Test
    @Category(Categories.valid.class)
    public void getDataReturnsNullWhenNoDataIsSet() {
        DbQueryStatus dbQueryStatus = new DbQueryStatus("test message", new DbQueryExecResult());
        assertNull(dbQueryStatus.getData());
    }
    @Test
    @Category(Categories.valid.class)
    public void getDataReturnsCorrectDataWhenDataIsSet() {
        DbQueryStatus dbQueryStatus = new DbQueryStatus("test message", new DbQueryExecResult());
        Object expectedData = "test data";
        dbQueryStatus.setData(expectedData);
        assertEquals(expectedData, dbQueryStatus.getData());
    }
    @Test
    @Category(Categories.valid.class)
    public void getDataReturnsCorrectDataType() {
        DbQueryStatus dbQueryStatus = new DbQueryStatus("test message", new DbQueryExecResult());
        Object expectedData = "test data";
        dbQueryStatus.setData(expectedData);
        assertTrue(dbQueryStatus.getData() instanceof String);
    }
    @Test
    @Category(Categories.valid.class)
    public void getDataReturnsNullAfterSettingDataToNull() {
        DbQueryStatus dbQueryStatus = new DbQueryStatus("test message", new DbQueryExecResult());
        dbQueryStatus.setData("test data");
        dbQueryStatus.setData(null);
        assertNull(dbQueryStatus.getData());
    }
    @Test
    @Category(Categories.valid.class)
    public void getDataDoesNotModifyInternalState() {
        DbQueryStatus dbQueryStatus = new DbQueryStatus("test message", new DbQueryExecResult());
        Object expectedData = "test data";
        dbQueryStatus.setData(expectedData);
        dbQueryStatus.getData();
        dbQueryStatus.getData();
        assertEquals(expectedData, dbQueryStatus.getData());
    }
}
