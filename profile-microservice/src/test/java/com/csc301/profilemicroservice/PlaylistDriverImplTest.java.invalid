@Test
@Category(Categories.invalid.class)
public void songNotInPlaylist() {
    
    String userName = "testUser";
    String songId = "invalidSong";
    Map<String, Object> params = new HashMap<>();
    params.put("plName", userName + "-favourites");
    params.put("songId", songId);
    when(driverMock.session()).thenReturn(sessionMock);
    when(sessionMock.beginTransaction()).thenReturn(transactionMock);
    
    when(transactionMock.run("MATCH (p:playlist {plName: $plName}) RETURN p", params)).thenReturn(statementResultMock);
    when(statementResultMock.hasNext()).thenReturn(true);
    
    when(transactionMock.run("MATCH (s:song {songId: $songId}) RETURN s", params)).thenReturn(statementResultMock);
    when(statementResultMock.hasNext()).thenReturn(true);
    
    when(transactionMock.run("MATCH (p:playlist {plName: $plName})-[r:includes]->(s:song {songId: $songId}) RETURN r", params)).thenReturn(statementResultMock);
