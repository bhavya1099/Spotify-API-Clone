*/public void likeSongAddsSongToPlaylist() {
    Mockito.when(driver.session()).thenReturn(session);
    Mockito.when(session.beginTransaction()).thenReturn(transaction);
    Mockito.when(transaction.run(Mockito.anyString(), Mockito.anyMap())).thenReturn(statementResult);
    Mockito.when(statementResult.hasNext()).thenReturn(true).thenReturn(true).thenReturn(false);
    DbQueryStatus status = playlistDriver.likeSong("user123", "song123");
    assertEquals("PUT", (String) status.getMessage());
