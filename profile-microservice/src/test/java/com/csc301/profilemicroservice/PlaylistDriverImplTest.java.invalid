*/public void validateResponseForMissingPlaylistNode() {
    Session mockSession = mock(Session.class);
    when(mockDriver.session()).thenReturn(mockSession);
    Transaction mockTransaction = mock(Transaction.class);
    when(mockSession.beginTransaction()).thenReturn(mockTransaction);
    StatementResult mockResult = mock(StatementResult.class);
    when(mockTransaction.run(anyString(), anyMap())).thenReturn(mockResult);
    when(mockResult.hasNext()).thenReturn(false);
    DbQueryStatus actualStatus = playlistDriver.unlikeSong("nonExistentUserName", "validSongId");
