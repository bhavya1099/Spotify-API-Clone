/*ROOST_METHOD_HASH=unlikeSong_eb7182672f
ROOST_METHOD_SIG_HASH=unlikeSong_04c9cef7dd

*/public void validatePlaylistAndSongIdNonExistence() {
    Session mockSession = mock(Session.class);
    when(mockDriver.session()).thenReturn(mockSession);
    Transaction mockTransaction = mock(Transaction.class);
    when(mockSession.beginTransaction()).thenReturn(mockTransaction);
    StatementResult mockPlaylistResult = mock(StatementResult.class);
    StatementResult mockSongResult = mock(StatementResult.class);
    when(mockTransaction.run(contains("MATCH (p:playlist"), anyMap())).thenReturn(mockPlaylistResult);
    when(mockTransaction.run(contains("MATCH (s:song"), anyMap())).thenReturn(mockSongResult);
    when(mockPlaylistResult.hasNext()).thenReturn(false);
    when(mockSongResult.hasNext()).thenReturn(false);
    DbQueryStatus actualStatus = playlistDriver.unlikeSong("userNameWithoutPlaylist", "songIdNonExistent");
    assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, (DbQueryExecResult) actualStatus.getdbQueryExecResult());
}

/*ROOST_METHOD_HASH=unlikeSong_eb7182672f
ROOST_METHOD_SIG_HASH=unlikeSong_04c9cef7dd

*/public void validateBehaviorWithSpecialCharacters() {
    Session mockSession = mock(Session.class);
    when(mockDriver.session()).thenReturn(mockSession);
    Transaction mockTransaction = mock(Transaction.class);
    when(mockSession.beginTransaction()).thenReturn(mockTransaction);
    StatementResult mockPlaylistResult = mock(StatementResult.class);
    StatementResult mockSongResult = mock(StatementResult.class);
    when(mockTransaction.run(contains("MATCH (p:playlist"), anyMap())).thenReturn(mockPlaylistResult);
    when(mockTransaction.run(contains("MATCH (s:song"), anyMap())).thenReturn(mockSongResult);
    when(mockPlaylistResult.hasNext()).thenReturn(true);
    when(mockSongResult.hasNext()).thenReturn(true);
    DbQueryStatus actualStatus = playlistDriver.unlikeSong("special@User#Name", "special*Song$Id");
    assertNotNull(actualStatus);
}
