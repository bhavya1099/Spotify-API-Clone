import okhttp3.Request;
import okhttp3.RequestBody;
import okhttp3.Response;

class ProfileControllerUnfollowFriendTest {
    private ProfileController profileController;
    @Mock
    private ProfileDriverImpl mockProfileDriver;
    
    @Mock
    private HttpServletRequest mockRequest;
    @BeforeEach
    void setup() {
        MockitoAnnotations.initMocks(this);
        profileController = new ProfileController(mockProfileDriver, null);
    }
    @Test
    @Tag("valid")
    public void unfollowExistingFriendSuccessfully() {
        String userName = "testUser";
        String friendUserName = "testFriend";
        when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("/unfollowFriend/" + userName + "/" + friendUserName));
        when(mockProfileDriver.unfollowFriend(userName, friendUserName))
            .thenReturn(new DbQueryStatus("Successfully unfollowed friend", DbQueryExecResult.QUERY_OK));
        Map<String, Object> response = profileController.unfollowFriend(userName, friendUserName, mockRequest);
        assertEquals("Successfully unfollowed friend", response.get("message"));
        assertEquals("PUT /unfollowFriend/testUser/testFriend", response.get("path"));
        assertEquals(DbQueryExecResult.QUERY_OK, ((DbQueryStatus) response.get("data")).getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void unfollowNonExistingFriendCheckErrorResponse() {
        String userName = "testUser";
        String friendUserName = "nonExistingFriend";
        when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("/unfollowFriend/" + userName + "/" + friendUserName));
        when(mockProfileDriver.unfollowFriend(userName, friendUserName))
            .thenReturn(new DbQueryStatus("Friend not found", DbQueryExecResult.QUERY_ERROR_NOT_FOUND));
        Map<String, Object> response = profileController.unfollowFriend(userName, friendUserName, mockRequest);
        assertEquals("Friend not found", response.get("message"));
        assertEquals("PUT /unfollowFriend/testUser/nonExistingFriend", response.get("path"));
        assertEquals(DbQueryExecResult.QUERY_ERROR_NOT_FOUND, ((DbQueryStatus) response.get("data")).getdbQueryExecResult());
    }
