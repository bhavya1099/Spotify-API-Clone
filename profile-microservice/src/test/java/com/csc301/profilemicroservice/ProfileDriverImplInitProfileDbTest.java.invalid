        inOrder.verify(transaction).run("CREATE CONSTRAINT ON (nProfile:profile) ASSERT exists(nProfile.password)");
        inOrder.verify(transaction).run("CREATE CONSTRAINT ON (nProfile:profile) ASSERT nProfile.userName IS UNIQUE");
