package com.csc301.profilemicroservice;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.http.HttpStatus;
import java.util.HashMap;
import java.util.Map;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.servlet.http.HttpServletRequest;
import okhttp3.RequestBody;

class UtilsSetResponseStatusTest {
    @Test
    @Tag("valid")
    public void successfulResponseWithNonNullData() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        String data = "Test Data";
        response = Utils.setResponseStatus(response, dbQueryExecResult, data);
        assertEquals(HttpStatus.OK, response.get("status"));
        assertEquals("Test Data", response.get("data"));
    }
    @Test
    @Tag("boundary")
    public void successfulResponseWithNullData() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        Object data = null;
        response = Utils.setResponseStatus(response, dbQueryExecResult, data);
        assertEquals(HttpStatus.OK, response.get("status"));
        assertFalse(response.containsKey("data"));
    }
    @Test
    @Tag("valid")
    public void responseForNotFoundError() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_ERROR_NOT_FOUND;
        response = Utils.setResponseStatus(response, dbQueryExecResult, null);
        assertEquals(HttpStatus.NOT_FOUND, response.get("status"));
        assertFalse(response.containsKey("data"));
    }
    @Test
    @Tag("valid")
    public void responseForGenericError() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_ERROR_GENERIC;
        response = Utils.setResponseStatus(response, dbQueryExecResult, null);
        assertEquals(HttpStatus.INTERNAL_SERVER_ERROR, response.get("status"));
        assertFalse(response.containsKey("data"));
    }
    @Test
    @Tag("invalid")
    public void nullResponseMap() {
        Map<String, Object> response = null;
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        String data = "Test Data";
        Exception exception = assertThrows(NullPointerException.class, () -> {
            Utils.setResponseStatus(response, dbQueryExecResult, data);
        });
        assertNotNull(exception.getMessage());
    }
    @Test
    @Tag("boundary")
    public void emptyResponseMapWithSuccessfulQuery() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        String data = "Test Data";
        response = Utils.setResponseStatus(response, dbQueryExecResult, data);
        assertEquals(HttpStatus.OK, response.get("status"));
        assertEquals("Test Data", response.get("data"));
    }
    @Test
    @Tag("valid")
    public void useOfEmptyRequestBodyField() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        Object data = Utils.emptyRequestBody; // Replace the value of emptyRequestBody with valid field from Utils if exists
        response = Utils.setResponseStatus(response, dbQueryExecResult, data);
        assertEquals(HttpStatus.OK, response.get("status"));
        assertEquals(Utils.emptyRequestBody, response.get("data")); // TODO change Utils.emptyRequestBody appropriately
    }
    @Test
    @Tag("invalid")
    public void unrecognizedDbQueryExecResult() {
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = null;
        Exception exception = assertThrows(IllegalArgumentException.class, () -> {
            Utils.setResponseStatus(response, dbQueryExecResult, null);
        });
        assertNotNull(exception.getMessage());
    }
    @Test
    @Tag("boundary")
    public void dataKeyShouldNotExistForErrors() {
        Map<String, Object> responseForNotFound = new HashMap<>();
        Map<String, Object> responseForGeneric = new HashMap<>();
        DbQueryExecResult dbQueryExecResultNotFound = DbQueryExecResult.QUERY_ERROR_NOT_FOUND;
        DbQueryExecResult dbQueryExecResultGeneric = DbQueryExecResult.QUERY_ERROR_GENERIC;
        responseForNotFound = Utils.setResponseStatus(responseForNotFound, dbQueryExecResultNotFound, "Test Data");
        responseForGeneric = Utils.setResponseStatus(responseForGeneric, dbQueryExecResultGeneric, "Test Data");
        assertFalse(responseForNotFound.containsKey("data"));
        assertFalse(responseForGeneric.containsKey("data"));
    }
    @Test
    @Tag("integration")
    public void validUrlGenerationInterdependency() {
        HttpServletRequest mockRequest = org.mockito.Mockito.mock(HttpServletRequest.class);
        org.mockito.Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com"));
        org.mockito.Mockito.when(mockRequest.getQueryString()).thenReturn("id=123");
        String url = Utils.getUrl(mockRequest);
        assertNotNull(url);
        assertEquals("http://example.com?id=123", url);
        Map<String, Object> response = new HashMap<>();
        DbQueryExecResult dbQueryExecResult = DbQueryExecResult.QUERY_OK;
        response = Utils.setResponseStatus(response, dbQueryExecResult, url);
        assertEquals(HttpStatus.OK, response.get("status"));
        assertEquals("http://example.com?id=123", response.get("data"));
    }
}