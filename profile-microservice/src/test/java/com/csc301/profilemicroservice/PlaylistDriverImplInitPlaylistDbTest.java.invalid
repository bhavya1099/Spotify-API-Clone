package com.csc301.profilemicroservice;
import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.Transaction;
import org.neo4j.driver.v1.exceptions.ServiceUnavailableException;
import org.neo4j.driver.v1.exceptions.ClientException;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.neo4j.driver.v1.StatementResult;
import org.springframework.stereotype.Repository;

public class PlaylistDriverImplInitPlaylistDbTest {
    @Tag("valid")
    @Test
    public void successfulDbInit(){
        Driver driver = mock(Driver.class);
        Session session = mock(Session.class); 
        Transaction trans = mock(Transaction.class);
        when(driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(trans);
   
        ProfileMicroserviceApplication.driver = driver;
        assertDoesNotThrow( () -> PlaylistDriverImpl.InitPlaylistDb()); 
        //asserting that no exception is thrown
        
        verify(session).beginTransaction();
        verify(trans).run("CREATE CONSTRAINT ON (nPlaylist:playlist) ASSERT exists(nPlaylist.plName)");
        verify(trans).success(); 
    }
    @Tag("invalid")
    @Test
    public void failedDbInitDueToInvalidQuery() {
        Driver driver = mock(Driver.class);
        Session session = mock(Session.class); 
        Transaction trans = mock(Transaction.class);
        when(driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(trans);
        when(trans.run("CREATE CONSTRAINT ON (nPlaylist:playlist) ASSERT exists(nPlaylist.plName)"))
                .thenThrow(ClientException.class);
                
        ProfileMicroserviceApplication.driver = driver;
        assertDoesNotThrow( () -> PlaylistDriverImpl.InitPlaylistDb()); 
        //even if query is invalid exception should be handled and not thrown
        
        verify(session).beginTransaction();
        verify(trans).run("CREATE CONSTRAINT ON (nPlaylist:playlist) ASSERT exists(nPlaylist.plName)");
    }
    @Tag("boundary")
    @Test
    public void failedDbInitDueToConnectionError() {
        Driver driver = mock(Driver.class);
        Session session = mock(Session.class); 
        Transaction trans = mock(Transaction.class);
        when(driver.session()).thenReturn(session).thenThrow(ServiceUnavailableException.class);
        when(session.beginTransaction()).thenReturn(trans);
        when(trans.run("CREATE CONSTRAINT ON (nPlaylist:playlist) ASSERT exists(nPlaylist.plName)"))
                .thenThrow(ServiceUnavailableException.class);
                
        ProfileMicroserviceApplication.driver = driver;
        assertThrows(ServiceUnavailableException.class, () -> PlaylistDriverImpl.InitPlaylistDb()); 
        
        //This time we expect ServiceUnavailableException to be thrown since this is what we are testing
        //and this exception should propagate up the call stack to notify of a service failure. 
    }
}