        ResponseBody responseBody = ResponseBody.create(MediaType.parse("application/json"), "{\"status\":\"OK\"}");
        when(responseMock.body()).thenReturn(responseBody);
        when(client.newCall(any(Request.class)).execute()).thenReturn(responseMock);
        
        Map<String, Object> response = profileController.unlikeSong(userName, songId, request);
        assertEquals(DbQueryExecResult.QUERY_OK, ((DbQueryStatus) response.get("dbQueryStatus")).getdbQueryExecResult());
        assertEquals("Success", (String) response.get("message"));
    }
