        mockedPlaylistDriver = mock(PlaylistDriverImpl.class);
        mockedProfileDriver = mock(ProfileDriverImpl.class);
        profileController = new ProfileController(mockedProfileDriver, mockedPlaylistDriver);
    }

    @Test
    @Category(Categories.valid.class)
    public void testUnlikeSongSuccess() throws Exception {
        // Arrange
        String userName = "testUser";
        String songId = "testSong";
        HttpServletRequest mockedRequest = mock(HttpServletRequest.class);
        when(mockedRequest.getRequestURL()).thenReturn(new StringBuffer("http://test.url"));
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        when(mockedPlaylistDriver.unlikeSong(anyString(), anyString())).thenReturn(mockDbQueryStatus);
        Response mockedResponse = mock(Response.class);

        // Mock response body setup
        okhttp3.ResponseBody mockedResponseBody = mock(okhttp3.ResponseBody.class);
        when(mockedResponseBody.string()).thenReturn("{\"status\":\"OK\"}");
        when(mockedResponse.body()).thenReturn(mockedResponseBody);

        profileController.client = mockedClient; // Using the mocked OkHttpClient for the test

        // Act
