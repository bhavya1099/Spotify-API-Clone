    private Driver driver = mock(Driver.class);
    private PlaylistDriverImpl playlistDriver = new PlaylistDriverImpl(); // Improved constructor to match PlaylistDriverImpl definition
    @Test
    @Category(Categories.valid.class)
    public void likeSongSuccessfully() {
        // Arrange
        String userName = "testUser";
        String songId = "testSong";
        Session session = mock(Session.class);
        Transaction transaction = mock(Transaction.class);
        StatementResult playlistResult = mock(StatementResult.class);
        StatementResult songResult = mock(StatementResult.class);
        StatementResult relationshipResult = mock(StatementResult.class);
        when(driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(transaction);
        Map<String, Object> params = new HashMap<>();
        params.put("plName", userName + "-favourites");
        params.put("songId", songId);
        when(transaction.run("MATCH (p:playlist {plName: $plName}) RETURN p", params)).thenReturn(playlistResult);
        when(transaction.run("MATCH (s:song {songId: $songId}) RETURN s", params)).thenReturn(songResult);
        when(transaction.run("MATCH r=(p:playlist {plName: $plName})-[:includes]->(s:song {songId: $songId}) RETURN r", params))
                .thenReturn(relationshipResult);
        when(playlistResult.hasNext()).thenReturn(true);
        when(songResult.hasNext()).thenReturn(true);
        when(relationshipResult.hasNext()).thenReturn(false);
        // Act
        DbQueryStatus result = playlistDriver.likeSong(userName, songId);
        // Assert
        assertEquals((String) "PUT", result.getDbQueryMessage()); // Modified for valid DbQueryStatus attribute
        assertEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, result.getDbQueryExecResult()); // Correct casting
        verify(transaction, times(1)).success();
        verify(session, times(1)).close();
    }
