package com.csc301.profilemicroservice;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Matchers;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.MockitoAnnotations;
import org.neo4j.driver.v1.*;
import java.util.HashMap;
import java.util.Map;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.experimental.categories.Category;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.StatementResult;
import org.neo4j.driver.v1.Transaction;
import org.springframework.stereotype.Repository;

public class PlaylistDriverImplLikeSongTest {
    @Mock
    private Driver driver;
    @Mock
    private Session session;
    @Mock
    private Transaction transaction;
    @Mock
    private StatementResult statementResult;
    private PlaylistDriverImpl playlistDriver;
    @BeforeEach
    public void setup() {
        MockitoAnnotations.openMocks(this);
        playlistDriver = new PlaylistDriverImpl(driver);
    }
    @AfterEach
    public void teardown() {
        playlistDriver = null;
        Mockito.reset(driver, session, transaction, statementResult);
    }
    
    @Test
    public void likeSongWithValidParameters() {
        String userName = "Alice";
        String songId = "1";
        DbQueryStatus expectedStatus = new DbQueryStatus("PUT", DbQueryExecResult.QUERY_OK);
        Mockito.when(driver.session()).thenReturn(session);
        Mockito.when(session.beginTransaction()).thenReturn(transaction);
        Mockito.when(transaction.run(Matchers.anyString(), Matchers.anyMap())).thenReturn(statementResult);
        Mockito.when(statementResult.hasNext()).thenReturn(false);
        
        DbQueryStatus status = playlistDriver.likeSong(userName, songId);
        assertEquals(expectedStatus.getStatus(), status.getStatus());
        assertEquals(expectedStatus.getMessage(), status.getMessage());
    }
    
    @Test
    public void likeSongWithNullOrBlankParameters() {
        Mockito.when(driver.session()).thenReturn(session);
        Mockito.when(session.beginTransaction()).thenReturn(transaction);
        DbQueryStatus status = playlistDriver.likeSong(null, "1");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
        status = playlistDriver.likeSong("", "1");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
        status = playlistDriver.likeSong("Alice", null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
        status = playlistDriver.likeSong("Alice", "");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
        status = playlistDriver.likeSong(null, null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
        status = playlistDriver.likeSong("", "");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
    }
    
    @Test
    public void likeSongWithDBConnectionError() {
        String userName = "Alice";
        String songId = "1";
        Mockito.when(driver.session()).thenThrow(new RuntimeException());
        
        DbQueryStatus status = playlistDriver.likeSong(userName, songId);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getStatus());
    }
}