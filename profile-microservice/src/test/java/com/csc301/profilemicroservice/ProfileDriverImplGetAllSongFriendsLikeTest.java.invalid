package com.csc301.profilemicroservice;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Record;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.StatementResult;
import org.neo4j.driver.v1.Transaction;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Repository;

class ProfileDriverImplGetAllSongFriendsLikeTest {
    @Mock
    Driver mockDriver;
    @Mock
    Session mockSession;
    @Mock
    Transaction mockTransaction;
    @Mock
    StatementResult userResult;
    @Mock
    StatementResult songResult;
    ProfileDriverImpl profileDriver;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.initMocks(this);
        profileDriver = new ProfileDriverImpl();
        profileDriver.driver = mockDriver;
    }
    @Test
    @Tag("valid")
    public void validInputRetrievesFollowersFavoriteSongs() {
        // Arrange
        String username = "validUser";
        List<Object> followers = List.of("follower1", "follower2");
        Map<String, Object> params = new HashMap<>();
        params.put("userName", username);
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(userResult);
        when(userResult.hasNext()).thenReturn(true);
        when(userResult.next()).thenReturn(mock(Record.class));
        when(userResult.next().get("userName")).thenReturn(followers);
        when(mockTransaction.run(anyString(), any())).thenReturn(songResult);
        when(songResult.hasNext()).thenReturn(true);
        when(songResult.next()).thenReturn(mock(Record.class));
        when(songResult.next().get("songs")).thenReturn(List.of("song1", "song2"));
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        assertTrue(result.getData() instanceof Map);
        assertEquals(followers.size(), ((Map<?, ?>) result.getData()).size());
        verify(mockTransaction).success();
    }
    @Test
    @Tag("invalid")
    public void nullInputReturnsError() {
        // Arrange
        String username = null;
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void nonExistentUserReturnsError() {
        // Arrange
        String username = "nonExistentUser";
        Map<String, Object> params = new HashMap<>();
        params.put("userName", username);
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(userResult);
        when(userResult.hasNext()).thenReturn(false);
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("boundary")
    public void userWithNoFollowersReturnsEmptyList() {
        // Arrange
        String username = "userWithoutFollowers";
        Map<String, Object> params = new HashMap<>();
        params.put("userName", username);
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(userResult);
        when(userResult.hasNext()).thenReturn(true);
        when(userResult.next()).thenReturn(mock(Record.class));
        when(userResult.next().get("userName")).thenReturn(new ArrayList<>());
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        assertTrue(result.getData() instanceof Map);
        assertTrue(((Map<?, ?>) result.getData()).isEmpty());
    }
    @Test
    @Tag("boundary")
    public void followersWithNoFavoriteSongsReturnEmptyLists() {
        // Arrange
        String username = "userWithFollowersNoSongs";
        List<Object> followers = List.of("follower1", "follower2");
        Map<String, Object> params = new HashMap<>();
        params.put("userName", username);
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(userResult);
        when(userResult.hasNext()).thenReturn(true);
        when(userResult.next()).thenReturn(mock(Record.class));
        when(userResult.next().get("userName")).thenReturn(followers);
        when(mockTransaction.run(anyString(), any())).thenReturn(songResult);
        when(songResult.hasNext()).thenReturn(false);
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        Map<?, ?> resultData = (Map<?, ?>) result.getData();
        assertEquals(followers.size(), resultData.size());
        for (Object follower : followers) {
            assertTrue(((List<?>) resultData.get(follower)).isEmpty());
        }
    }
    @Test
    @Tag("invalid")
    public void databaseConnectionFailure() {
        // Arrange
        String username = "anyUser";
        when(mockDriver.session()).thenThrow(new RuntimeException("Database connection failed"));
        // Act
