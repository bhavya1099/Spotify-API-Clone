    @Test
    @Tag("integration")
    public void largeFollowersAndSongsHandledEfficiently() {
        String userName = "largeTestUser";
        Map<String, Object> params = new HashMap<>();
        params.put("userName", userName);
        StatementResult mockUserResult = mock(StatementResult.class);
        Record mockFollowerRecord = mock(Record.class);
        List<Object> followersList = new ArrayList<>();
        for (int i = 0; i < 1000; i++) {
            followersList.add("follower" + i);
        }
        when(mockFollowerRecord.get("userName")).thenReturn((Value) followersList);
        when(mockUserResult.hasNext()).thenReturn(true);
        when(mockUserResult.next()).thenReturn(mockFollowerRecord);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(any(String.class), eq(params))).thenReturn(mockUserResult);
        List<Object> songsList = Arrays.asList("song1", "song2");
        StatementResult mockSongResult = mock(StatementResult.class);
        Record mockSongRecord = mock(Record.class);
        when(mockSongResult.hasNext()).thenReturn(true);
        when(mockSongResult.next()).thenReturn(mockSongRecord);
        when(mockSongRecord.get("songs")).thenReturn((Value) songsList);
        when(mockTransaction.run(any(String.class), any(Map.class))).thenReturn(mockSongResult);
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(userName);
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        Map<String, List<Object>> data = (Map<String, List<Object>>) result.getData();
        assertEquals(1000, data.size());
        for (int i = 0; i < 1000; i++) {
            assertEquals(songsList, data.get("follower" + i));
        }
    }
