    @Test
    @Category(Categories.valid.class)
    public void testMethodValidUserWithFollowersAndSongs() {
        String userName = "testUser";
        Map<String, Object> expectedData = new HashMap<>();
        expectedData.put("follower1", Arrays.asList("song1", "song2"));
        expectedData.put("follower2", Arrays.asList("song3"));
        Session session = Mockito.mock(Session.class);
        Transaction transaction = Mockito.mock(Transaction.class);
        StatementResult userResult = Mockito.mock(StatementResult.class);
        StatementResult songResult1 = Mockito.mock(StatementResult.class);
        StatementResult songResult2 = Mockito.mock(StatementResult.class);
        when(driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(transaction);
        when(transaction.run(any(String.class), any(Map.class))).thenReturn(userResult, songResult1, songResult2);
        when(userResult.hasNext()).thenReturn(true, false);
        when(userResult.next()).thenReturn(Mockito.mock(Record.class));
        Record record = Mockito.mock(Record.class);
        when(record.get("userName")).thenReturn(Value.list(new String[]{"follower1", "follower2"}));
        when(songResult1.hasNext()).thenReturn(true);
        when(songResult1.next()).thenReturn(Mockito.mock(Record.class));
        when(songResult1.next().get("songs")).thenReturn(Value.list(new String[]{"song1", "song2"}));
        when(songResult2.hasNext()).thenReturn(true);
        when(songResult2.next()).thenReturn(Mockito.mock(Record.class));
        when(songResult2.next().get("songs")).thenReturn(Value.list(new String[]{"song3"}));
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(userName);
        assertEquals(expectedData, result.getData());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
    }
