    @Test
    @Tag("valid")
    public void userWithFollowersHavingValidSongs() {
        // Arrange
        String username = "userWithSongs";
        List<Object> followers = List.of("follower1", "follower2");
        List<Object> favoriteSongsFollower1 = List.of("song1", "song2");
        List<Object> favoriteSongsFollower2 = List.of("song3", "song4");
        Map<String, Object> params = new HashMap<>();
        params.put("userName", username);
        when(mockDriver.session()).thenReturn(mockSession);
        when(mockSession.beginTransaction()).thenReturn(mockTransaction);
        when(mockTransaction.run(anyString(), eq(params))).thenReturn(userResult);
        when(userResult.hasNext()).thenReturn(true);
        when(userResult.next()).thenReturn(mock(Record.class));
        when(userResult.next().get("userName")).thenReturn(followers);
        when(mockTransaction.run(anyString(), any())).thenReturn(songResult);
        when(songResult.hasNext()).thenReturn(true);
        when(songResult.next()).thenReturn(mock(Record.class));
        when(songResult.next().get("songs"))
            .thenReturn(favoriteSongsFollower1)
            .thenReturn(favoriteSongsFollower2);
        // Act
        DbQueryStatus result = profileDriver.getAllSongFriendsLike(username);
        // Assert
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        Map<?, ?> resultData = (Map<?, ?>) result.getData();
        assertEquals(followers.size(), resultData.size());
        assertEquals(favoriteSongsFollower1, resultData.get("follower1"));
        assertEquals(favoriteSongsFollower2, resultData.get("follower2"));
