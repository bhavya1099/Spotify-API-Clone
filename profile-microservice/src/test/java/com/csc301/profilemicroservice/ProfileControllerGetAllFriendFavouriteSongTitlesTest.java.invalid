        expectedResponse = new HashMap<>();
    }
    @Test
    @Tag("valid")
    void shouldRetrieveAllFriendFavouriteSongs() {
        DbQueryStatus queryStatus = new DbQueryStatus("success", DbQueryExecResult.QUERY_OK);
        expectedResponse.put("path", "GET " + Utils.getUrl(request));
        expectedResponse.put("message", queryStatus.getMessage());
        expectedResponse.put("data", "sample data");
        when(profileDriver.getAllSongFriendsLike(USERNAME)).thenReturn(queryStatus);
        Map<String, Object> actualResponse = controller.getAllFriendFavouriteSongTitles(USERNAME, request);
        assertEquals(expectedResponse, actualResponse);
    }
    @Test
    @Tag("invalid")
