        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void createUserProfileWithNullFullName() {
        DbQueryStatus result = profileDriverImpl.createUserProfile("user1", null, "password123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void createUserProfileWithNullPassword() {
        DbQueryStatus result = profileDriverImpl.createUserProfile("user1", "Full Name", null);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void createUserProfileWithDatabaseException() {
        when(mockDriver.session()).thenThrow(RuntimeException.class);
        DbQueryStatus result = profileDriverImpl.createUserProfile("user1", "Full Name", "password123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("integration")
    public void createUserProfilePlaylistCreationValidation() {
        Map<String, Object> params = new HashMap<>();
        params.put("userName", "user1");
        params.put("fullName", "Full Name");
        params.put("password", "password123");
        params.put("plName", "user1-favourites");
        when(mockSession.writeTransaction(any())).thenAnswer(invocation -> {
            Transaction tx = invocation.getArgument(0);
            verify(tx, times(1)).run("CREATE (m:profile {userName: $userName, fullName: $fullName, password: $password})-[r:created]->(n:playlist {plName: $plName})", params);
            return null;
        });
        DbQueryStatus result = profileDriverImpl.createUserProfile("user1", "Full Name", "password123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
    }
    @Test
