@Tag("valid")
public class ProfileDriverImplCreateUserProfileTest {
    private ProfileDriverImpl profileDriverImpl;
    private Driver mockDriver;
    private Session mockSession;
    private Transaction mockTransaction;
    @BeforeEach
    public void setUp() {
        mockDriver = mock(Driver.class);
        mockSession = mock(Session.class);
        mockTransaction = mock(Transaction.class);
        profileDriverImpl = new ProfileDriverImpl();
        profileDriverImpl.driver = mockDriver;
        when(mockDriver.session()).thenReturn(mockSession);
    }
    @AfterEach
    public void tearDown() {
        profileDriverImpl = null;
        reset(mockDriver, mockSession, mockTransaction);
    }
    @Test
    @Tag("valid")
    public void createUserProfileWithValidInputs() {
        when(mockSession.writeTransaction(any())).thenReturn(null);
        DbQueryStatus result = profileDriverImpl.createUserProfile("user1", "Full Name", "password123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void createUserProfileWithNullUserName() {
        DbQueryStatus result = profileDriverImpl.createUserProfile(null, "Full Name", "password123");
