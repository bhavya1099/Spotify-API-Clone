@Category(Categories.integration.class)
@Test
public void integrationTestWithPlaylistDriver() {
    
    
    String songId = "12345";
    
    String songName = "Integration Song";
    when(mockRequest.getRequestURI()).thenReturn("/api/add");
    when(playlistDriver.addSong(songId, songName)).thenReturn(new DbQueryStatus("Successfully connected", DbQueryExecResult.QUERY_OK));
    
    Map<String, Object> result = profileController.addProfile(songId, songName, mockRequest);
    
    assertEquals("POST /api/add", result.get("path"));
    assertEquals("Successfully connected", (String) result.get("message"));
    assertEquals(DbQueryExecResult.QUERY_OK, result.get("status"));
}
