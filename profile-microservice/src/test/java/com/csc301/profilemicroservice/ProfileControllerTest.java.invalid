*/public void validateSuccessfulSongAddition() {
    
    
    String songId = "123";
    
    String songName = "Test Song Name";
    String expectedPath = String.format("POST %s", "/mocked/path");
    String expectedMessage = "Song successfully added";
    DbQueryStatus mockDbQueryStatus = new DbQueryStatus(expectedMessage, DbQueryExecResult.QUERY_OK);
    when(request.getRequestURI()).thenReturn("/mocked/path");
    when(playlistDriver.addSong(songId, songName)).thenReturn(mockDbQueryStatus);
    
    Map<String, Object> response = profileController.addProfile(songId, songName, request);
    
    assertEquals(expectedPath, response.get("path"));
    assertEquals(expectedMessage, response.get("message"));
    
    assertEquals(DbQueryExecResult.QUERY_OK, (DbQueryExecResult) response.get("status"));
}

