@Category(Categories.valid.class)
@Test
public void addSongSuccessfully() {
    
    
    String songId = "12345";
    
    String songName = "Test Song";
    when(mockRequest.getRequestURI()).thenReturn("/api/add");
    when(playlistDriver.addSong(songId, songName)).thenReturn(new DbQueryStatus("Song added successfully", DbQueryExecResult.QUERY_OK));
    
    Map<String, Object> result = profileController.addProfile(songId, songName, mockRequest);
    
    assertEquals("POST /api/add", result.get("path"));
    assertEquals("Song added successfully", (String) result.get("message"));
    assertEquals(DbQueryExecResult.QUERY_OK, result.get("status"));
}

