@Category(Categories.valid.class)
public void testAddSongSuccessfully() {
    
    
    String songId = "dummySongId";
    
    String songName = "dummySongName";
    
    String mockedPath = "POST /addProfile";
    DbQueryStatus dbQueryStatusMock = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
    when(request.getRequestURI()).thenReturn("/addProfile");
    when(playlistDriver.addSong(songId, songName)).thenReturn(dbQueryStatusMock);
    
    Map<String, Object> response = profileController.addProfile(songId, songName, request);
    
    assertEquals(mockedPath, response.get("path"));
    assertEquals(dbQueryStatusMock.getMessage(), response.get("message"));
    assertEquals("Success", ((String) dbQueryStatusMock.getMessage()));
}

