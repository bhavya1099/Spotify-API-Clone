/*ROOST_METHOD_HASH=likeSong_b915241087
ROOST_METHOD_SIG_HASH=likeSong_538288bf51

*/public void likeSongSuccessfully() throws Exception {
    String userName = "existingUser";
    String songId = "validSongId";
    String mockUrl = "http:
    DbQueryStatus mockStatus = new DbQueryStatus("Success message", DbQueryExecResult.QUERY_OK);
    when(mockRequest.getRequestURI()).thenReturn(mockUrl);
    when(playlistDriver.likeSong(userName, songId)).thenReturn(mockStatus);
    
    Response mockResponse = mock(Response.class);
    when(mockResponse.body()).thenReturn(ResponseBody.create("{\"status\":\"OK\"}", MediaType.parse("application/json")));
    when(client.newCall(any()).execute()).thenReturn(mockResponse);
    Map<String, Object> response = profileController.likeSong(userName, songId, mockRequest);
    assertEquals("Success message", (String) response.get("message"));
    assertEquals("OK", mockStatus.getdbQueryExecResult().toString());
    assertEquals("PUT " + mockUrl, (String) response.get("path"));
}

