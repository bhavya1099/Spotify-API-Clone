    public void validUnfollowFriendTwoUsers() {
        // Arrange
        Map<String, Object> params = new HashMap<>();
        params.put("userName", "user1");
        params.put("frndUserName", "user2");
        
        StatementResult mockResult = mock(StatementResult.class);
        when(driver.session()).thenReturn(mock(Session.class));
        when(driver.session().beginTransaction()).thenReturn(transaction);
        when(transaction.run("MATCH (n:profile {userName: $userName}) RETURN n.userName as u", params)).thenReturn(mockResult);
        when(transaction.run("MATCH (n:profile {userName: $frndUserName}) RETURN n.userName as f", params)).thenReturn(mockResult);
        when(mockResult.hasNext()).thenReturn(true);
        
        Record mockRecord = mock(Record.class);
        when(transaction.run("RETURN EXISTS( (:profile {userName: $userName})-[:follows]->(:profile {userName: $frndUserName}) ) as bool", params)).thenReturn(mockResult);
        when(mockResult.next()).thenReturn(mockRecord);
        when(mockRecord.get("bool").asBoolean()).thenReturn(true);
        
        // Act
        DbQueryStatus status = profileDriverImpl.unfollowFriend("user1", "user2");
        
        // Assert
        assertNotNull(status);
        assertEquals("POST", status.getMessage());
        assertEquals(DbQueryExecResult.QUERY_OK, status.getdbQueryExecResult());
    }
