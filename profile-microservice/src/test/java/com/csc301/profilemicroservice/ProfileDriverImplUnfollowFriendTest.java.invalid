    public void nullParametersValidation() {
        DbQueryStatus result1 = profileDriver.unfollowFriend(null, "validUserName");
        DbQueryStatus result2 = profileDriver.unfollowFriend("validUserName", null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result1.getdbQueryExecResult());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result2.getdbQueryExecResult());
    }
