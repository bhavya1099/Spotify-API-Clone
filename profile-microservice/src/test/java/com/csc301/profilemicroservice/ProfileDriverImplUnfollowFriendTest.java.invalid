    public void successfulUnfollowValidation() {
        when(neo4jDriverMock.session()).thenReturn(sessionMock);
        when(sessionMock.beginTransaction()).thenReturn(transactionMock);
        when(transactionMock.run(anyString(), anyMap())).thenReturn(statementResultMock);
        when(statementResultMock.hasNext()).thenReturn(true);
        Record recordMock = mock(Record.class);
        when(statementResultMock.next()).thenReturn(recordMock);
        when(recordMock.get("bool").asBoolean()).thenReturn(true); // Simulating a valid relationship
        DbQueryStatus result = profileDriver.unfollowFriend("validUserName", "validFrndUserName");
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
