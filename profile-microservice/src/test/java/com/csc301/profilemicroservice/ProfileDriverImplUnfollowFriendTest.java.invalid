        when(sessionMock.beginTransaction()).thenReturn(transactionMock);
        when(transactionMock.run(anyString(), anyMap())).thenReturn(statementResultMock);
        when(statementResultMock.hasNext()).thenReturn(false); // Simulating user does not exist scenario
        DbQueryStatus result = profileDriver.unfollowFriend("nonExistentUser", "validUserName");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void notFriendsValidation() {
        when(neo4jDriverMock.session()).thenReturn(sessionMock);
        when(sessionMock.beginTransaction()).thenReturn(transactionMock);
